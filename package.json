{
  "name": "dsh-plugin-wordcloud",
  "version": "0.1.0",
  "description": "Local word frequency statistics for DeepSeek Harness conversations.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merc-hecl/dsh-plugin-wordcloud.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/host.js",
  "exports": {
    ".": "./src/host.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src/host.js",
    "src/statistics.js",
    "src/tokenize.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.en.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "bundleDependencies": [
    "franc",
    "jieba-wasm",
    "mdast-util-from-markdown",
    "stopword"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "node --test"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "dependencies": {
    "franc": "6.2.0",
    "jieba-wasm": "2.4.0",
    "mdast-util-from-markdown": "^2.0.2",
    "stopword": "3.1.5"
  },
  "devDependencies": {
    "changelogen": "0.6.2",
    "esbuild": "^0.28.0"
  }
}
